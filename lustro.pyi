from collections.abc import Iterator, Sequence
from typing import TypedDict, final

import numpy as np
import numpy.typing as npt
from typing_extensions import Buffer, Self

__all__ = [
    "__version__",
    "lustro_api_version",
    "runtime_info",
    "runtime_preview",
    "RuntimeInfo",
    "configure",
    "SEED_LEN",
    "BLOCK_LEN",
    "HASH128_LEN",
    "HASH256_LEN",
    "SNAPSHOT_LEN",
    "BATCH_SNAPSHOT_HEADER_LEN",
    "BATCH_SNAPSHOT_LANE_LEN",
    "SnapshotError",
    "hash256",
    "hash128",
    "hash256_many_fixed",
    "hash128_many_fixed",
    "hash256_many_fixed_into",
    "hash128_many_fixed_into",
    "hash256_many_var",
    "hash128_many_var",
    "hash256_many_var_into",
    "hash128_many_var_into",
    "LustroHasher",
    "LustroPrng",
    "LustroPrngBatch",
    "LustroXof",
    "LustroXofAbsorber",
    "LustroXofBatch",
]

__version__: str

SEED_LEN: int
BLOCK_LEN: int
HASH128_LEN: int
HASH256_LEN: int
SNAPSHOT_LEN: int
BATCH_SNAPSHOT_HEADER_LEN: int
BATCH_SNAPSHOT_LANE_LEN: int

class SnapshotError(ValueError): ...

def lustro_api_version() -> int: ...
class RuntimeInfo(TypedDict):
    backend: str
    threads: int
    fixed: bool
    parallel_built: bool
    simd_available: bool
    pool_usable: bool
    logical_cpus: int

def runtime_info() -> RuntimeInfo: ...
def runtime_preview() -> RuntimeInfo: ...
def configure(threads: int | None = None, allow_simd: bool | None = None) -> None: ...
# Input buffers: bytes is used as is. Other objects (bytearray, memoryview, array('B'),
# NumPy uint8) are copied; they must be C-contiguous with byte items, else TypeError.
def hash256(data: Buffer) -> bytes: ...
def hash128(data: Buffer) -> bytes: ...
def hash256_many_fixed(data: npt.NDArray[np.uint8]) -> npt.NDArray[np.uint8]: ...
def hash128_many_fixed(data: npt.NDArray[np.uint8]) -> npt.NDArray[np.uint8]: ...
def hash256_many_fixed_into(
    data: npt.NDArray[np.uint8], out: npt.NDArray[np.uint8], *, release_gil: bool = True
) -> None: ...
def hash128_many_fixed_into(
    data: npt.NDArray[np.uint8], out: npt.NDArray[np.uint8], *, release_gil: bool = True
) -> None: ...
def hash256_many_var(
    messages: Sequence[Buffer], *, release_gil: bool = True
) -> npt.NDArray[np.uint8]: ...
def hash128_many_var(
    messages: Sequence[Buffer], *, release_gil: bool = True
) -> npt.NDArray[np.uint8]: ...
def hash256_many_var_into(
    messages: Sequence[Buffer], out: npt.NDArray[np.uint8], *, release_gil: bool = True
) -> None: ...
def hash128_many_var_into(
        messages: Sequence[Buffer], out: npt.NDArray[np.uint8], *, release_gil: bool = True
) -> None: ...

@final
class LustroHasher:
    def __new__(cls, length: int) -> Self: ...
    def update(self, data: Buffer) -> None: ...
    def digest(self) -> bytes: ...
    def hexdigest(self) -> str: ...
    def remaining(self) -> int: ...
    def copy(self) -> Self: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: object) -> Self: ...

@final
class LustroPrng:
    def __new__(cls, seed: Buffer, stream_id: int = 0) -> Self: ...
    @staticmethod
    def from_entropy(stream_id: int = 0) -> LustroPrng: ...
    def next_u32(self) -> int: ...
    def next_u64(self) -> int: ...
    def next_u128(self) -> int: ...
    def next_block(self) -> bytes: ...
    def advance_bytes(self, n: int) -> None: ...
    def advance_blocks(self, n: int) -> None: ...
    def position(self) -> int: ...
    def fill(self, size: int) -> bytes: ...
    def fill_into(self, buf: Buffer) -> None: ...
    def read(self, size: int) -> bytes: ...
    def readinto(self, buf: Buffer) -> int: ...
    def fill_u64(self, n: int) -> npt.NDArray[np.uint64]: ...
    def copy(self) -> Self: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: object) -> Self: ...
    def __reduce__(self) -> tuple[object, tuple[bytes]]: ...
    def fork(self, id: int) -> Self: ...
    def fork_batch(self, ids: Sequence[int]) -> LustroPrngBatch: ...
    def fork_batch_range(self, first: int, count: int) -> LustroPrngBatch: ...
    def fork_path(self, path: Sequence[int]) -> Self: ...
    @staticmethod
    def derive_path(seed: Buffer, path: Sequence[int]) -> LustroPrng: ...
    def export_snapshot(self) -> bytes: ...
    @staticmethod
    def import_snapshot(bytes: Buffer) -> LustroPrng: ...

@final
class LustroPrngBatch:
    def __new__(cls, seed: Buffer, stream_ids: Sequence[int]) -> Self: ...
    @staticmethod
    def new_range(seed: Buffer, first_stream_id: int, count: int) -> LustroPrngBatch: ...
    @staticmethod
    def from_streams(streams: Sequence[LustroPrng]) -> LustroPrngBatch: ...
    def __len__(self) -> int: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def copy(self) -> Self: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, _memo: object) -> Self: ...
    def __reduce__(self) -> tuple[object, tuple[bytes]]: ...
    def __getitem__(self, index: int) -> LustroPrng: ...
    def __iter__(self) -> Iterator[LustroPrng]: ...
    def lane(self, i: int) -> LustroPrng: ...
    def release_buffer(self) -> None: ...
    def suggested_steps(self) -> int: ...
    def fill_blocks(
        self, out: npt.NDArray[np.uint64], steps: int, *, release_gil: bool = True
    ) -> None: ...
    def blocks(self, steps: int) -> npt.NDArray[np.uint64]: ...
    def fork(self, ids: Sequence[int]) -> Self: ...
    def fork_many(self, ids: Sequence[int]) -> Self: ...
    def fork_range(self, first: int) -> Self: ...
    @staticmethod
    def derive_path(seed: Buffer, roots: Sequence[int], path: Sequence[int]) -> LustroPrngBatch: ...
    def export_snapshot(self) -> bytes: ...
    @staticmethod
    def import_snapshot(bytes: Buffer) -> LustroPrngBatch: ...

